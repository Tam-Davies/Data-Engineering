# ── Copy this to .env and fill in your values ────────────────

# POS API
POS_API_BASE=http://localhost:5000
POS_API_KEY=
FETCH_INTERVAL=300

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ordr_db
DB_USER=postgres
DB_PASS=your_password_here

# Email alerts (Gmail example)
EMAIL_ENABLED=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=ordr-alerts@yourdomain.com
EMAIL_TO=manager@yourdomain.com

# Slack alerts
SLACK_ENABLED=false
SLACK_WEBHOOK=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_CHANNEL=#sales-alerts

# Logging
LOG_LEVEL=INFO
LOG_FILE=pipeline/logs/pipeline.log
